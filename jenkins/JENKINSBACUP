pipeline {
    agent {
        label 'Built-In' 
    }      
    stages {
        stage('Backup Jenkins Home') {
            steps {
                sh '''
                cd /var/lib/jenkins
                zip -r JENKINSBACUP.zip jenkins
                '''
            }
        }
        stage('Store Backup into s3') {
            steps {
                script {
                  s3Upload consoleLogLevel: 'INFO', dontSetBuildResultOnFailure: false, dontWaitForConcurrentBuildCompletion: false, entries: [[bucket: 'jenkinsbacup-mb', excludedFile: '', flatten: false, gzipFiles: false, keepForever: false, managedArtifacts: false, noUploadOnFailure: false, selectedRegion: 'us-east-1', showDirectlyInBrowser: false, sourceFile: '/var/lib/Jenkins/JENKINSBACUP.zip', storageClass: 'STANDARD', uploadFromSlave: false, useServerSideEncryption: false]], pluginFailureResultConstraint: 'FAILURE', profileName: 'S3BACUP', userMetadata: []
                }
            }
        }
    }
}
